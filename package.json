{
    "name": "@altshiftab/utils",
    "version": "0.0.8",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/altshiftab/utils_js.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "exports": {
        "./http/errors": {
            "import": "./dist/http/errors.js",
            "types": "./dist/http/errors.d.ts"
        },
        "./http/types": {
            "import": "./dist/http/types.js",
            "types": "./dist/http/types.d.ts"
        },
        "./http/utils": {
            "import": "./dist/http/utils.js",
            "types": "./dist/http/utils.d.ts"
        },
        "./cbor": {
            "import": "./dist/cbor/cbor.js",
            "types": "./dist/cbor/cbor.d.ts"
        },
        "./cose": {
            "import": "./dist/cose/cose.js",
            "types": "./dist/cose/cose.d.ts"
        },
        "./browser/error_reporting": {
            "import": "./dist/browser/error_reporting.js",
            "types": "./dist/browser/error_reporting.d.ts"
        },
        "./browser/session": {
            "import": "./dist/browser/session.js",
            "types": "./dist/browser/session.d.ts"
        },
        "./browser/view_transition": {
            "import": "./dist/browser/view_transition.js",
            "types": "./dist/browser/view_transition.d.ts"
        },
        "./browser/routing": {
            "import": "./dist/browser/routing.js",
            "types": "./dist/browser/routing.d.ts"
        }
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc",
        "test": "tsc -p tsconfig.test.json && node --test \"build/test/**/*.test.js\""
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "typescript": "^7.0.2"
    }
}
